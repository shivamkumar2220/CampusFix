# Copy this file to ".env" and change the values for your computer.
# Never upload your real .env file to GitHub.

# ----- PostgreSQL connection -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusfix
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ----- JWT login tokens -----
# Use a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Background SLA job -----
ENABLE_SCHEDULER=true
SLA_CHECK_INTERVAL_MINUTES=15

# ----- CORS: which frontend addresses may call the API -----
# * allows all (fine for a college project). Example for one address:
#   CORS_ALLOWED_ORIGINS=http://localhost:5500
CORS_ALLOWED_ORIGINS=*
